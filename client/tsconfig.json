{
  "compilerOptions": {
    "target": "es6",
    "lib": ["es2017", "dom"],
    /* Скрипты внедряются в PrestaShop как глобальные: import/export сломает вызовы из inline-кода виджетов. */
    "module": "none",
    "strict": true,
    "types": [],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  /* Каждый скрипт собирается отдельно (tsconfig.backend.json / tsconfig.front.json):
     в общем глобальном scope их объявления конфликтуют. */
  "files": []
}
