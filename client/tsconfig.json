{
  "compilerOptions": {
    /* es2020: при более низком target TypeScript разворачивает ?. в глобальный `var _a`,
       а бандлы виджетов объявляют свой `const _a` и падают с SyntaxError. */
    "target": "es2020",
    "lib": ["es2020", "dom"],
    /* Скрипты внедряются в PrestaShop как глобальные: import/export сломает вызовы из inline-кода виджетов. */
    "module": "none",
    "strict": true,
    "types": [],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src",
    "outDir": "../prestashop/shopserver/views/js"
  },
  /* Оба скрипта живут в одной глобальной области, поэтому имена верхнего уровня
     не должны пересекаться между backend.ts и front.ts. */
  "include": ["src"]
}
